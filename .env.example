# Required: Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Custom API base URL (default: https://api.anthropic.com)
# Uncomment and set if using a relay/proxy service
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional: Tavily API key for search functionality (Agents B/D/E use this)
TAVILY_API_KEY=your_tavily_api_key_here

# Data source: "wind" (requires Wind terminal) or "akshare" (free, may be delayed)
DATA_SOURCE=wind
